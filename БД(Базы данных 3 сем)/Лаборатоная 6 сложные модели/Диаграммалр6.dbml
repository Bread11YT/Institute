Enum order_status {
  processing
  completed
  cancelled
}
 
Table category {
  category_id int [pk, increment]
  name varchar(100) [not null, unique]
  description text
}
 
Table supplier {
  supplier_id int [pk, increment]
  name varchar(150) [not null, unique]
  phone varchar(20)
  email varchar(255) [unique]
  address varchar(255)
}
 
Table product {
  product_id int [pk, increment]
  name varchar(200) [not null]
  category_id int [not null, ref: > category.category_id]
  supplier_id int [not null, ref: > supplier.supplier_id]
  price decimal(10,2) [not null]
  stock_quantity int [not null, default: 0]
  arrival_date date [not null]
}
 
Table customer {
  customer_id int [pk, increment]
  first_name varchar(100) [not null]
  last_name varchar(100) [not null]
  email varchar(255) [not null, unique]
  phone varchar(20)
}
 
Table orders {
  order_id int [pk, increment]
  order_date datetime [not null, default: `now()`]
  status order_status [not null, default: 'processing']
  customer_id int [not null, ref: > customer.customer_id]
}
 
Table order_product {
  order_id int [ref: > orders.order_id]
  product_id int [ref: > product.product_id]
  quantity int [not null]
  price_at_order decimal(10,2) [not null]
  indexes {
    (order_id, product_id) [pk]
  }
}
