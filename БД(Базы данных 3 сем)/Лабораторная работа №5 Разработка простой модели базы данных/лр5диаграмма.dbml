Table category {
  category_id int [pk, increment]
  name varchar(100) [not null, unique]
  description text
}

Table product {
  product_id int [pk, increment]
  name varchar(200) [not null]
  category_id int [not null, ref: > category.category_id]
  price decimal(10,2) [not null]
  stock_quantity int [not null, default: 0]
}

Table customer {
  customer_id int [pk, increment]
  first_name varchar(100) [not null]
  last_name varchar(100) [not null]
  email varchar(255) [not null, unique]
  phone varchar(20)
}

Table sale {
  sale_id int [pk, increment]
  sale_date date [not null]
  customer_id int [not null, ref: > customer.customer_id]
  total_amount decimal(12,2) [not null, default: 0]
}

Table sale_item {
  sale_id int [ref: > sale.sale_id]
  product_id int [ref: > product.product_id]
  quantity int [not null]
  unit_price decimal(10,2) [not null]

  indexes {
    (sale_id, product_id) [pk]
  }
}